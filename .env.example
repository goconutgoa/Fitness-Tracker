# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...your_service_role_key

# Public URL that Claude.ai will connect to (no trailing slash)
# Local dev: http://localhost:8080
# Prod: https://fitness-nutrition-mcp.onrender.com
PUBLIC_BASE_URL=http://localhost:8080

# Secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=replace_me_with_random_48_bytes
SESSION_SECRET=replace_me_with_random_48_bytes

# Optional: comma-separated admin emails (future use)
ADMIN_EMAILS=

# Uvicorn
PORT=8080
